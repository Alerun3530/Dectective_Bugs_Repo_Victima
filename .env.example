# URL del webhook de n8n (Railway) que recibe los crashes (Bug 1 y 2).
N8N_WEBHOOK_URL=el webhook de n8n que recibe los crashes (Bug 1 y 2).

# Datos de Supabase para que la página de historial se autoconecte sola.
# OJO: acá va la clave PUBLISHABLE (sb_publishable_...), nunca la secret,
# porque este valor termina viajando al navegador.
SUPABASE_URL= supabase url para que la página de historial se autoconecte sola.
SUPABASE_PUBLISHABLE_KEY= la clave PUBLISHABLE (sb_publishable_...), nunca la secret, porque este valor termina viajando al navegador.
